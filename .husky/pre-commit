# ステージ済みのTerraformファイルを取得
STAGED_TF_FILES=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '^terraform/.*\.tf$' || true)

if [ -n "$STAGED_TF_FILES" ]; then
  echo "Checking staged Terraform files..."

  # 未ステージの変更があるファイルは自動整形しない
  echo "$STAGED_TF_FILES" | while IFS= read -r file; do
    if ! git diff --quiet -- "$file"; then
      echo "Error: Unstaged changes detected in $file"
      echo "Stage or stash those changes before committing."
      exit 1
    fi
  done || exit 1

  echo "Formatting staged Terraform files..."

  echo "$STAGED_TF_FILES" | while IFS= read -r file; do
    terraform fmt "$file" || exit 1
    git add -- "$file" || exit 1
  done || exit 1
fi
